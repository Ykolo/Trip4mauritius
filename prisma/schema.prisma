// MauriExplore — schéma canonique.
// Voir docs/BACKEND-PLAN.md.
//
// ⚠️ NE JAMAIS lancer `prisma db push` sur ce projet.
// Les contraintes CHECK (capacité des créneaux, cohérence des montants) ne sont
// pas exprimables en Prisma : elles vivent dans le SQL des migrations, écrit à
// la main. `db push` court-circuite les migrations et les supprimerait
// silencieusement — la survente redeviendrait possible sans aucune erreur.
// Utiliser exclusivement `prisma migrate dev` / `prisma migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 : plus d'`url` ni de `directUrl` ici.
// URL des commandes CLI  → prisma.config.ts (endpoint direct)
// URL du runtime         → driver adapter dans lib/db.ts (endpoint poolé)
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth — modèles imposés par l'adapter.
// Structure dictée par Better Auth : on l'étend (role, locale), on ne la
// renomme pas. Se battre contre l'adapter coûte plus cher à chaque montée de
// version que d'accepter ses conventions.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?

  // additionalFields Better Auth — le rôle voyage dans la session, ce qui évite
  // un aller-retour base à chaque requête tRPC.
  role   UserRole @default(tourist)
  locale String   @default("fr")

  // Valeur PAR DÉFAUT du contact, pas la source de vérité d'une réservation :
  // le numéro qu'un opérateur doit composer vit sur Booking.contactPhone (on
  // réserve pour ses parents, ou avec une carte SIM locale achetée sur place).
  // Ici uniquement pour pré-remplir le formulaire.
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  operator Operator?
  bookings Booking[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id String @id @default(cuid())
  // Requis par Better Auth >= 1.7. Le CLI @better-auth/cli est bloqué en 1.4 et
  // ne le connaît pas : il valide un schéma que la librairie rejette ensuite au
  // runtime. Ne pas se fier au CLI seul pour vérifier ce modèle.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Domaine
// ---------------------------------------------------------------------------

enum UserRole {
  tourist
  operator
  admin

  // Kled, le prestataire. Au-dessus de `admin` : il commande les interrupteurs
  // de fonctionnalité, qui décident de ce que le client voit. Créé par le seed
  // uniquement, comme `admin` — aucun endpoint ne fabrique l'un ou l'autre.
  superadmin
}

enum ActivityStatus {
  draft
  pending_moderation
  published
  rejected
  // Les activités sont archivées, jamais supprimées : activities→slots est en
  // CASCADE et slots→bookings en RESTRICT, donc une suppression d'activité
  // réservée casserait sur une contrainte de clé étrangère illisible.
  archived
}

enum BookingStatus {
  // pending_payment / expired ne sont pas utilisés tant que Stripe n'est pas
  // branché, mais restent définis : ajouter un état plus tard est une
  // migration, l'omettre forcerait à réécrire la machine à états.
  pending_payment
  confirmed
  expired
  cancelled
  completed
  // « Créée » : réservée par le touriste, pas encore validée par l'opérateur.
  // En FIN d'énumération parce que `ALTER TYPE ... ADD VALUE` ajoute à la fin —
  // un ordre différent ici ferait détecter une dérive au prochain diff Prisma.
  // Le cycle de vie complet est documenté dans `lib/booking-status.ts`.
  pending_validation
}

model Operator {
  id              String  @id @default(cuid())
  userId          String  @unique
  displayName     String
  avatarUrl       String?
  verified        Boolean @default(false)
  stripeAccountId String? @unique
  payoutEnabled   Boolean @default(false)

  /// Numéro WhatsApp professionnel, celui que le back-office compose pour
  /// joindre le prestataire au sujet d'une réservation.
  ///
  /// Volontairement DISTINCT de `User.phone`, qui est le numéro personnel du
  /// compte : le titulaire le modifie depuis /account, et une entreprise change
  /// de gérant sans changer de ligne commerciale. Même raisonnement que
  /// `Booking.contactPhone`, qui fige le numéro du touriste pour ne pas dépendre
  /// de son profil.
  ///
  /// Nullable, et ça restera : les opérateurs existants n'en ont pas, et le
  /// bouton WhatsApp se désactive plutôt que de composer un numéro inventé.
  whatsapp String?

  /// Un opérateur qui porte déjà des réservations ne se SUPPRIME pas :
  /// `activities → slots` est en CASCADE mais `slots → bookings` en RESTRICT,
  /// donc la suppression casserait sur une clé étrangère illisible — et
  /// effacerait l'historique de touristes qui, eux, n'ont rien demandé.
  ///
  /// On le désactive : ses activités passent en `archived`, son compte retombe
  /// en `tourist`, les réservations déjà prises restent intactes et
  /// consultables. Même grammaire que `Category.active` et
  /// `GuideCategory.active` — on désactive, on ne supprime pas.
  ///
  /// La suppression franche reste possible tant qu'AUCUNE réservation n'existe :
  /// c'est le cas de l'opérateur créé par erreur, qu'il serait absurde de garder
  /// à vie dans la liste.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("operators")
}

/// Catalogue des catégories, administré depuis /admin/categories.
///
/// Avant, `Activity.category` était un texte libre et la liste des choix
/// vivait en dur dans TROIS composants qui ne disaient pas la même chose :
/// l'accueil filtrait sur `diving`/`mer`/`terre`, les filtres sur « Sports
/// Nautiques », et le formulaire opérateur écrivait « Water Sports ». Les
/// vignettes de l'accueil ne renvoyaient donc aucun résultat.
///
/// `slug` est ce qui voyage dans l'URL (`/activities?category=water-sports`) :
/// le changer casse les liens partagés et les favoris.
model Category {
  id       String  @id @default(cuid())
  slug     String  @unique
  label    String  @unique
  emoji    String?
  imageUrl String?

  /// Ordre d'affichage choisi par l'admin ; l'ordre alphabétique mettrait
  /// « Aventure » avant « Sports nautiques » sur une île où l'on vient d'abord
  /// pour la mer.
  position Int @default(0)

  /// Une catégorie ne se supprime pas — la clé étrangère des activités le
  /// refuserait. On la désactive : elle disparaît des filtres et du
  /// formulaire, les activités déjà classées dedans restent intactes.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]

  @@index([active, position])
  @@map("categories")
}

/// Classification des guides — SÉPARÉE de celle des activités, volontairement.
///
/// « Stationnement » ou « Sécurité » n'ont rien à faire dans les filtres du
/// catalogue, et renommer « Nature » côté activités ne doit pas toucher aux
/// articles. Deux usages, deux listes, deux écrans d'administration.
model GuideCategory {
  id    String @id @default(cuid())
  slug  String @unique
  label String @unique

  /// Même raison que pour les catégories d'activités : l'ordre alphabétique ne
  /// dit rien de l'importance éditoriale.
  position Int @default(0)

  /// On désactive, on ne supprime pas : la clé étrangère des guides le
  /// refuserait, et les articles déjà classés doivent survivre.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guides Guide[]

  @@index([active, position])
  @@map("guide_categories")
}

/// Article éditorial : un texte long et des images.
model Guide {
  id         String @id @default(cuid())
  categoryId String

  /// Vit dans l'URL publique et dans les liens partagés : jamais modifié après
  /// création, comme le slug d'une activité.
  slug  String @unique
  title String

  /// Chapô affiché dans les listes. Séparé du corps : en extraire les premières
  /// lignes produirait une accroche coupée au milieu d'une phrase.
  excerpt String

  /// Le corps de l'article, en Markdown.
  content String

  /// Des URLs, jamais de fichiers — le projet n'a aucun envoi. La première sert
  /// d'image de couverture.
  imageUrls String[]

  status GuideStatus @default(draft)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category GuideCategory @relation(fields: [categoryId], references: [id])

  /// L'index qui sert la page publique : les publiés d'une catégorie, du plus
  /// récent au plus ancien.
  @@index([status, categoryId, updatedAt])
  @@map("guides")
}

/// Deux états seulement. Il n'y a pas de modération au lot 1 : un guide est en
/// brouillon ou en ligne, et c'est Trip4mauritius qui décide.
enum GuideStatus {
  draft
  published
}

model Activity {
  id         String @id @default(cuid())
  operatorId String
  categoryId String
  slug       String @unique

  title    String
  region   String
  duration String

  // priceFrom, exposé par le front, est DÉRIVÉ — jamais stocké.
  priceHt         Decimal @db.Decimal(10, 2)
  maxParticipants Int

  languages String[] @default([])
  imageUrls String[] @default([])
  included  String[] @default([])
  excluded  String[] @default([])

  // Les 5 clés fr|en|de|es|ru sont validées par Zod à l'écriture : un objet
  // partiel casse l'affichage sans lever d'erreur.
  description Json @default("{}")

  status ActivityStatus @default(draft)

  // Alimentés par rien pour l'instant (les avis sont hors périmètre) : le seed
  // les fixe en dur. Colonnes en attente, pas une fonctionnalité.
  rating      Decimal? @db.Decimal(2, 1)
  reviewCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operator Operator       @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // Restrict, comme slots→bookings : une catégorie encore utilisée ne doit pas
  // pouvoir disparaître sous les activités qui la référencent.
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  slots    ActivitySlot[]

  @@index([status, region, categoryId])
  @@index([operatorId])
  @@index([categoryId])
  @@map("activities")
}

model ActivitySlot {
  id         String @id @default(cuid())
  activityId String

  // timestamptz. Tout formatage vers date/heure affichée est épinglé sur
  // Indian/Mauritius (UTC+4) — jamais le fuseau du navigateur, sous peine
  // d'afficher un départ de 09:00 à 07:00 pour un touriste à Paris.
  startsAt DateTime @db.Timestamptz(6)

  maxSpots Int
  // Compteur croissant. On ne stocke JAMAIS spotsLeft : un compteur qui ne fait
  // qu'augmenter se protège par une contrainte, et rend la survente impossible.
  spotsTaken Int @default(0)

  createdAt DateTime @default(now())

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([activityId, startsAt])
  @@index([activityId, startsAt])
  @@map("activity_slots")
}

model Booking {
  id         String @id @default(cuid())
  bookingRef String @unique
  userId     String
  slotId     String

  participants     Int
  totalPrice       Decimal @db.Decimal(10, 2)
  depositDue       Decimal @db.Decimal(10, 2)
  balanceDueOnSite Decimal @db.Decimal(10, 2)

  // Le numéro que l'opérateur compose pour CE départ. Figé à la réservation :
  // s'il pointait sur User.phone, une modification de profil réécrirait le
  // contact de réservations déjà passées.
  contactPhone String?

  status                BookingStatus @default(pending_validation)
  stripePaymentIntentId String?       @unique
  expiresAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  slot     ActivitySlot @relation(fields: [slotId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([slotId])
  @@map("bookings")
}

model Payment {
  id                    String  @id @default(cuid())
  bookingId             String
  stripePaymentIntentId String  @unique
  amount                Decimal @db.Decimal(10, 2)
  currency              String  @default("EUR")
  status                String
  raw                   Json?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("payments")
}

// Idempotence des webhooks Stripe : Stripe rejoue ses événements, et sans cette
// table un rejeu double-confirmerait une réservation.
model ProcessedStripeEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

/// Bascule à chaud des interrupteurs de fonctionnalité.
///
/// Cette table ne contient QUE les clés explicitement basculées depuis
/// /admin/features : l'absence de ligne signifie « laisser décider
/// l'environnement, puis le défaut du code ». La liste des flags existants vit
/// dans `lib/features.ts`, jamais ici — une clé en base qui n'y figure plus est
/// ignorée à la lecture.
model FeatureFlag {
  key     String  @id
  enabled Boolean

  /// Email de l'admin qui a basculé, figé au moment du clic — pas une clé
  /// étrangère. Même raison que `Booking.contactPhone` : le journal doit
  /// survivre à la suppression du compte, et il enregistre qui a agi ce
  /// jour-là, pas qui porte cet identifiant aujourd'hui.
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}
