# Copier en `.env` et renseigner. Ne jamais committer le `.env` réel.
#
# ⚠️ Le .env local doit pointer sur la branche Neon "dev", JAMAIS sur la
# production. `prisma migrate dev`, `migrate reset` et le seed sont
# destructifs : les faire tourner sur la prod détruirait de vraies données.
# Récupérer l'URL de la branche dev depuis la console Neon.

# --- Base de données (branche Neon "dev") ---------------------------------
# Endpoint poolé — utilisé par le runtime via le driver adapter.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
# Endpoint direct (sans -pooler) — `prisma migrate` exige une connexion directe.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# --- Better Auth -----------------------------------------------------------
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Utiliser un secret DIFFÉRENT en production.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Fournisseurs sociaux (optionnels) -------------------------------------
# Non renseignés = fournisseur simplement non enregistré, l'app démarre quand
# même. Voir lib/auth.ts.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Email (requis pour le magic link et la vérification d'adresse) --------
# Tant qu'absent, requireEmailVerification reste désactivé dans lib/auth.ts —
# à réactiver avant toute mise en ligne.
RESEND_API_KEY=""

# --- Interrupteurs de fonctionnalité ---------------------------------------
# Toutes OPTIONNELLES. Absentes, c'est le défaut déclaré dans lib/features.ts
# qui s'applique. Elles servent à différencier un environnement d'un autre
# (preview vs production) AVANT que quiconque n'ouvre /admin/features.
#
# ⚠️ La base a le dernier mot : une bascule faite dans /admin/features écrase
# la valeur posée ici. Pour rendre la main à cette variable, utiliser le lien
# « rendre la main » de l'écran d'administration.
#
# Valeurs acceptées : true/false, 1/0, on/off, yes/no. Toute autre valeur est
# ignorée avec un avertissement dans les logs.
# FEATURE_OPERATOR_SELF_SIGNUP=""
# FEATURE_CURRENCY_SELECTOR=""
# FEATURE_WHATSAPP_CONTACT=""
